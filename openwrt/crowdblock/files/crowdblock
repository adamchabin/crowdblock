#!/usr/bin/ucode -s
// crowdblock - crowd-sourced IP blocklist client for OpenWrt
//
//   crowdblock run        daemon: download the list and load it, every sync_interval
//   crowdblock sync       download the list and load it once
//   crowdblock teardown   remove the nftables table (unblocks everything)
'use strict';

import * as fs from 'fs';
import * as uloop from 'uloop';

import { load as load_config } from 'crowdblock.config';
import { debug, info, warn_log, error_log } from 'crowdblock.logging';
import { fetch_list, each_entry, set_hash, VERSION } from 'crowdblock.api';
import * as nft from 'crowdblock.nft';

const TMP_DIR = '/tmp/crowdblock';
const STATE_FILE = TMP_DIR + '/state.json';
const BLOCKED_FILE = TMP_DIR + '/blocked.json';

let sync_state = {};
sync_state.daemon_start = time();
sync_state.failures = 0;
sync_state.last_error = null;
sync_state.last_success_sync = null;
sync_state.blocked = {};
sync_state.list_etag = null;
sync_state.last_sync = null;  // end of the last sync attempt
sync_state.next_sync = null;  // when the daemon's timer fires next
sync_state.nft_loaded_at = null;  // when the elements were last added to nftables
sync_state.list_size = 0;

function fatal(msg) {
	warn(msg, '\n');
	exit(1);
}

// Writes the blocked addresses to BLOCKED_FILE for the UI, separately from
// state.json. Written to a temporary file first, so the UI never reads a
// half-written list.
function write_blocked() {
	let tmp = BLOCKED_FILE + '.tmp';
	let f = fs.open(tmp, 'w');
	if (!f)
		return;

	// One record at a time: a single JSON string of the whole list would
	// double the memory use on a large list.
	let first = true;
	f.write('{');
	for (let ip in sync_state.blocked) {
		f.write((first ? '' : ',') + sprintf('%J:%J', ip, sync_state.blocked[ip]));
		first = false;
	}
	f.write('}');
	f.close();
	fs.rename(tmp, BLOCKED_FILE);
}

// Zapisuje aktualny stan do STATE_FILE dla UI.
function write_state() {
	let state = {
		daemon_start: sync_state.daemon_start,
		failures: sync_state.failures,
		last_error: sync_state.last_error,
		last_success_sync: sync_state.last_success_sync,
		last_sync: sync_state.last_sync,
		next_sync: sync_state.next_sync,
		list_size: sync_state.list_size,
		list_etag: sync_state.list_etag,
		nft_loaded_at: sync_state.nft_loaded_at,
		blocked_count: sync_state.blocked_count,
		blocked_v6: sync_state.blocked_v6,
		version: VERSION,
	};
	// json() parses JSON text; %J turns the object into JSON text.
	let state_json = sprintf('%J', state);
	let f = fs.open(STATE_FILE, 'w');
	if (f) {
		f.write(state_json);
		f.close();
	}
}

// Returns the canonical address of a list entry, or null if it is invalid.
function entry_ip(e) {
	if (type(e) != 'object' || type(e.ip) != 'string' || !iptoarr(e.ip))
		return null;

	return arrtoip(iptoarr(e.ip));
}

// Stores list entry `e` in the blocked map `st`. Returns null when it was
// stored, else why it was skipped: 'invalid', 'below' or 'over' (max_entries).
// `c.n` counts the stored addresses, so the limit needs no scan of the map.
function store_entry(cfg, st, c, e, expiry) {
	let ip = entry_ip(e);
	if (!ip)
		return 'invalid';

	// Don't rely on the server-side filter alone.
	if (!(e.distinct_reporters >= cfg.min_reports))
		return 'below';

	if (!exists(st, ip)) {
		if (c.n >= cfg.max_entries)
			return 'over';
		c.n++;
	}

	st[ip] = {
		expires: expiry,
		reports: e.distinct_reporters || 0,
		country: e.country || '-',
		sources: e.sources || [],
	};
	return null;
}

// Rebuilds sync_state.blocked from the downloaded full list. Returns null or
// an error.
function load_full(cfg, expiry, stats) {
	let st = {}, c = { n: 0 };

	let err = each_entry(function(e) {
		stats.total++;
		let why = store_entry(cfg, st, c, e, expiry);
		if (why)
			stats[why] = stats[why] + 1;
	});
	if (err)
		return err;

	sync_state.blocked = st;
	return null;
}

// Records an address before the delta changes it: changes[ip] is whether it
// was in the map (and so in nftables) before this sync. Only the first call
// per address counts, so an address changed twice is listed once.
function note_change(changes, st, ip) {
	if (!exists(changes, ip))
		changes[ip] = exists(st, ip);
}

// Applies a delta to sync_state.blocked and checks the result against the
// server's count and set hash. Every touched address is recorded in `changes`
// (see note_change). Returns null if it matches, else an error: the caller
// then fetches the full list.
function apply_delta(cfg, d, changes, expiry) {
	let st = sync_state.blocked;
	let c = { n: length(keys(st)) };

	for (let ip in d.remove) {
		let bytes = (type(ip) == 'string') ? iptoarr(ip) : null;
		if (!bytes)
			continue;

		note_change(changes, st, arrtoip(bytes));
		if (exists(st, arrtoip(bytes))) {
			delete st[arrtoip(bytes)];
			c.n--;
		}
	}

	for (let e in d.upsert) {
		let ip = entry_ip(e);
		if (ip)
			note_change(changes, st, ip);

		let why = store_entry(cfg, st, c, e, expiry);

		// Now below min_reports: the address leaves the list.
		if (why == 'below' && ip && exists(st, ip)) {
			delete st[ip];
			c.n--;
		}
	}

	let ips = keys(st);
	if (length(ips) != d.count)
		return sprintf('delta gives %d addresses, the server has %d', length(ips), d.count);

	if (set_hash(ips) != d.set_hash)
		return 'delta does not match the server set hash';

	return null;
}

// Milliseconds since `t0`, a clock(true) reading. ms_since() rounds to whole
// seconds, too coarse for the phase timings below.
function elapsed_ms(t0) {
	let t = clock(true);
	return (t[0] - t0[0]) * 1000 + (t[1] - t0[1]) / 1000000;
}

// Counts the blocked addresses (all IPv4 and IPv6) into sync_state, so that
// state.json can show them without reading the list. Returns the total.
function count_blocked() {
	let total = 0, v6 = 0;
	for (let ip in sync_state.blocked) {
		total++;
		if (index(ip, ':') >= 0)
			v6++;
	}

	sync_state.blocked_count = total;
	sync_state.blocked_v6 = v6;
	return total;
}

// Reads a JSON object file. Returns null if it is missing or malformed.
function read_json(path) {
	let f = fs.open(path, 'r');
	if (!f)
		return null;

	let data;
	try { data = json(f.read('all')); } catch (e) { }
	f.close();

	return (type(data) == 'object') ? data : null;
}

// A separate `crowdblock sync` process starts with no memory of the last
// sync. The etag and the counts come from state.json (small); the blocked map
// comes from blocked.json (large) and is read only when a delta or an nftables
// refresh needs it. The etag is trusted only together with that map: if
// blocked.json is missing, the full list is fetched instead.
let saved_loaded = false;
let map_loaded = false;

function load_saved() {
	if (saved_loaded)
		return;
	saved_loaded = true;

	let state = read_json(STATE_FILE);
	if (type(state?.list_etag) == 'string') {
		sync_state.list_etag = state.list_etag;
		sync_state.nft_loaded_at = (type(state.nft_loaded_at) in [ 'int', 'double' ]) ? state.nft_loaded_at : null;
		sync_state.blocked_count = state.blocked_count;
		sync_state.blocked_v6 = state.blocked_v6;
	}
}

// Reads the blocked map back from blocked.json. Returns false (and drops the
// etag, so the next fetch is a full list) if the map is missing.
function load_map() {
	if (map_loaded)
		return true;

	let blocked = read_json(BLOCKED_FILE);
	if (!blocked) {
		sync_state.list_etag = null;
		return false;
	}

	sync_state.blocked = blocked;
	count_blocked();
	map_loaded = true;
	return true;
}

// nftables must be refreshed when its table is new, the elements were never
// added, or half of block_time has passed since the last refresh. Returns why
// as text, or null when no refresh is due.
function nft_refresh_reason(cfg, table_new) {
	if (table_new)
		return 'table recreated';
	if (sync_state.nft_loaded_at == null)
		return 'first load';
	if (time() - sync_state.nft_loaded_at >= int(cfg.block_time / 2))
		return 'half of block_time passed';
	return null;
}

// Downloads the list (a delta when the server can send one) and loads every
// blocked address into nftables. Returns true on success.
function sync(cfg) {
	let start = clock(true);
	let stats = { total: 0, invalid: 0, below: 0, over: 0 };
	let table_new = false;
	let changes = {};  // address -> was it in the map before this sync (see note_change)

	load_saved();

	let res = fetch_list(cfg, sync_state.list_etag);
	if (res.error) {
		sync_state.failures++;
		sync_state.last_error = res.error;
		write_state();
		error_log('sync failed: %s', res.error);
		return false;
	}

	let now = time();
	let expiry = now + cfg.block_time;
	let due_reason = nft_refresh_reason(cfg, table_new);
	let due = due_reason != null;

	// Unchanged list and nftables still fresh: the map is not needed at all.
	if (res.not_modified && !due) {
		sync_state.failures = 0;
		sync_state.last_error = null;
		sync_state.last_success_sync = now;
		write_state();
		info('sync ok (list not modified): %d blocked, etag %s', sync_state.blocked_count ?? 0, replace(sync_state.list_etag ?? '-', '"', ''));
		debug(cfg, 'sync: done in %d ms', elapsed_ms(start));
		return true;
	}

	// A delta is applied to the saved map, and a refresh of nftables needs it.
	if (res.delta || res.not_modified) {
		if (!load_map()) {
			res = fetch_list(cfg, null);
			if (res.error) {
				sync_state.failures++;
				sync_state.last_error = res.error;
				write_state();
				error_log('sync failed: %s', res.error);
				return false;
			}
		}
	}

	if (res.delta) {
		let delta_err = apply_delta(cfg, res.delta, changes, expiry);
		if (delta_err) {
			warn_log('delta rejected (%s), fetching the full list', delta_err);
			sync_state.list_etag = null;
			res = fetch_list(cfg, null);
			if (res.error) {
				sync_state.failures++;
				sync_state.last_error = res.error;
				write_state();
				error_log('sync failed: %s', res.error);
				return false;
			}
		}
	}

	if (!res.not_modified && !res.delta) {
		let parse_err = load_full(cfg, expiry, stats);
		if (parse_err) {
			sync_state.failures++;
			sync_state.last_error = parse_err;
			write_state();
			error_log('sync failed: %s', parse_err);
			return false;
		}
		map_loaded = true;
	}

	// Kernel timeouts of the elements run out after block_time, so every element
	// is re-added by a full refresh at least every half of block_time. A changed
	// list in between is applied to the changed addresses only, which costs
	// time in proportion to the change, not to the whole list.
	let changed = !res.not_modified;
	let refresh_due = changed || due;
	let refresh_full = due || !res.delta;

	if (refresh_due && !refresh_full) {
		let phase = clock(true);
		let del = [], add = [];
		for (let ip in keys(changes)) {
			if (changes[ip])
				push(del, ip);
			if (exists(sync_state.blocked, ip))
				push(add, ip);
		}

		let delta_nft_err = nft.load_changes(cfg, del, add);
		if (delta_nft_err) {
			warn_log('nft delta update failed (%s), loading the full set', delta_nft_err);
			refresh_full = true;
		}
		else {
			debug(cfg, 'sync: nft delta of %d removed, %d added in %d ms', length(del), length(add), elapsed_ms(phase));
		}
	}

	if (refresh_due && refresh_full) {
		let phase = clock(true);
		let st = sync_state.blocked;
		let ips = keys(st);
		for (let ip in ips)
			st[ip].expires = expiry;

		let load_err = nft.load(cfg, ips);

		// The firewall may have flushed the table (`fw4 stop`): recreate it and
		// load again. Checked only when the elements are loaded, so the normal
		// path runs no extra nft command.
		if (load_err && nft.is_missing_table(load_err)) {
			warn_log('nftables table missing (firewall restarted?), recreating it');
			table_new = true;
			let setup_err = nft.setup(cfg);
			load_err = setup_err ?? nft.load(cfg, ips);
		}

		if (load_err) {
			sync_state.failures++;
			sync_state.last_error = load_err;
			write_state();
			error_log('nft update failed: %s', load_err);
			return false;
		}
		sync_state.nft_loaded_at = now;
		debug(cfg, 'sync: full nft load of %d addresses in %d ms', length(ips), elapsed_ms(phase));
	}

	let count = count_blocked();

	// Saved only now: a failed nft update is retried with the same list.
	if (changed) {
		sync_state.list_etag = res.delta ? res.delta.etag : res.etag;
		sync_state.list_size = res.delta ? res.delta.count : stats.total;
	}
	sync_state.failures = 0;
	sync_state.last_error = null;
	sync_state.last_success_sync = now;
	write_state();
	if (refresh_due)
		write_blocked();

	let how = !changed ? ' (list not modified)' : res.delta ? ' (delta)' : '';

	// Say why nftables got a full reload, not only that it did.
	if (refresh_due && refresh_full)
		how += sprintf(' [nft full reload: %s]', table_new ? 'table recreated' : (due_reason ?? (res.delta ? 'delta failed' : 'full list')));

	info('sync ok%s: %d blocked (%d below min_reports, %d invalid%s, etag %s) in %d ms',
		how, count, stats.below, stats.invalid,
		stats.over ? sprintf(', %d dropped: max_entries reached', stats.over) : '',
		replace(sync_state.list_etag ?? '-', '"', ''),
		elapsed_ms(start));
	debug(cfg, 'DEBUG');
	return true;
}

// Records when the last sync attempt ended and when the next one is due, so
// the UI can show both. Called after every attempt, success or not.
function record_sync(next) {
	sync_state.last_sync = time();
	sync_state.next_sync = next;
	write_state();
}

function cmd_run(cfg) {
	info('crowdblock %s started: server=%s min_reports=%d block_time=%ds interval=%ds',
		VERSION, cfg.server, cfg.min_reports, cfg.block_time, cfg.sync_interval);

	uloop.init();

	let timer;
	timer = uloop.timer(1000, function() {
		sync(cfg);
		timer.set(cfg.sync_interval * 1000);
		record_sync(time() + cfg.sync_interval);
	});

	uloop.run();
}

function cmd_sync(cfg) {
	let ok = sync(cfg);
	record_sync(null);
	exit(ok ? 0 : 1);
}

function usage() {
	warn('Usage: crowdblock run|sync|teardown\n');
	exit(1);
}

fs.mkdir(TMP_DIR, 0o700);

let command = ARGV[0];

if (command == 'teardown') {
	let err = nft.teardown();
	if (err)
		fatal(err);
}
else if (command == 'run' || command == 'sync') {
	let res = load_config();
	if (res.error)
		fatal(`config error: ${res.error}`);

	if (command == 'run')
		cmd_run(res.cfg);
	else
		cmd_sync(res.cfg);
}
else {
	usage();
}
