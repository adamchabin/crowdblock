#!/usr/bin/ucode -s
// crowdblock - crowd-sourced IP blocklist client for OpenWrt
//
//   crowdblock run       daemon (started by /etc/init.d/crowdblock)
//   crowdblock sync      one-shot download + apply
//   crowdblock sync --dry-run   show what would be blocked, change nothing
//   crowdblock status    show state and drop counters
//   crowdblock teardown  remove nftables table (unblocks everything)
//   crowdblock report IP [SOURCE]  tell the server that IP attacked this router
//   crowdblock pause IP  stop blocking IP (until resumed)
//   crowdblock resume IP block a paused IP again
'use strict';

import * as fs from 'fs';
import * as uloop from 'uloop';
import { rand, srand } from 'math';

import { load as load_config, load_paused, save_paused } from 'crowdblock.config';
import { debug, info, warn_log, error_log, ms_since } from 'crowdblock.logging';
import { whitelist, whitelisted, parse_cidr } from 'crowdblock.ip';
import { fetch_blocklist, each_entry, report_ip, VERSION } from 'crowdblock.api';
import * as nft from 'crowdblock.nft';

const STATE_DIR = '/tmp/crowdblock';
const STATE_FILE = STATE_DIR + '/state.json';

function log(fmt, ...args) {
	print(sprintf(fmt, ...args), '\n');
}

// Unlike die(), doesn't append the source location to the message.
function fatal(msg) {
	warn(msg, '\n');
	exit(1);
}

// --- state: { entries: { ip: expires_at }, reports: { ip: count },
//              countries: { ip: "CN" }, sources: { ip: [ "auth", ... ] },
//              static: { ip: true } (added from the static_block option),
//              list_etag, last_sync, last_error, failures (in a row),
//              list_size (addresses on the last downloaded list) } --------
// `reports`, `countries` and `sources` are from the last time the address
// was on the server list (shown in LuCI). `list_etag` identifies the list
// saved in /tmp/crowdblock/list.json (sent as If-None-Match).

function load_state() {
	let f = fs.open(STATE_FILE, 'r');
	let st;

	if (f) {
		try { st = json(f.read('all')); } catch (e) { }
		f.close();
	}

	if (type(st) != 'object' || type(st.entries) != 'object')
		st = { entries: {}, last_sync: null, last_error: null };

	// Maps added in later versions.
	for (let k in [ 'reports', 'countries', 'sources', 'static' ])
		if (type(st[k]) != 'object')
			st[k] = {};

	return st;
}

let state_dirty = false;

function save_state(st) {
	if (!state_dirty)
		return;
	state_dirty = false;

	let tmp = STATE_FILE + '.tmp';
	let f = fs.open(tmp, 'w');
	if (!f)
		return;

	f.write(sprintf('%J', st));
	f.close();
	fs.rename(tmp, STATE_FILE);
}

// --- persistence --------------------------------------------------------
// The state lives in /tmp (RAM). With option state_file a copy of the blocks
// is kept on flash/USB, so they are back right after a reboot instead of
// only after the first successful sync.

const PERSIST_INTERVAL = 6 * 3600;  // flash wear: don't write on every sync
let last_persist = 0;

// Copies the blocks to cfg.state_file, at most every PERSIST_INTERVAL.
function persist_state(cfg, st) {
	if (!cfg.state_file)
		return;

	let now = time();
	if (now - last_persist < PERSIST_INTERVAL)
		return;

	fs.mkdir(fs.dirname(cfg.state_file), 0o700);

	let tmp = cfg.state_file + '.tmp';
	let f = fs.open(tmp, 'w');
	if (!f) {
		warn_log('cannot write %s', tmp);
		return;
	}

	f.write(sprintf('%J', {
		saved_at: now,
		entries: st.entries, reports: st.reports, countries: st.countries,
		sources: st.sources, static: st.static,
	}));
	f.close();

	if (!fs.rename(tmp, cfg.state_file)) {
		warn_log('cannot replace %s', cfg.state_file);
		fs.unlink(tmp);
		return;
	}
	last_persist = now;
	debug(cfg, 'state saved to %s', cfg.state_file);
}

// Fills an empty state (fresh boot) from cfg.state_file. Returns the number
// of restored addresses.
function restore_state(cfg, st) {
	if (!cfg.state_file || length(keys(st.entries)))
		return 0;

	let f = fs.open(cfg.state_file, 'r');
	if (!f)
		return 0;

	let saved;
	try { saved = json(f.read('all')); } catch (e) { }
	f.close();

	if (type(saved) != 'object' || type(saved.entries) != 'object' || type(saved.saved_at) != 'int') {
		warn_log('ignoring %s: not a crowdblock state file', cfg.state_file);
		return 0;
	}

	let now = time();
	// A router without a battery clock starts in the past until NTP kicks in:
	// then count the remaining time from when the file was written instead of
	// trusting the absolute expiry (a block would last for years).
	let shift = (now < saved.saved_at) ? now - saved.saved_at : 0;
	let n = 0;

	for (let ip, expires in saved.entries) {
		if (n >= cfg.max_entries)
			break;
		if (!(type(expires) in [ 'int', 'double' ]) || !iptoarr(ip))
			continue;

		expires += shift;
		if (expires <= now)
			continue;
		if (expires > now + cfg.block_time)
			expires = now + cfg.block_time;

		st.entries[ip] = expires;
		n++;

		for (let k in [ 'reports', 'countries', 'sources', 'static' ])
			if (type(saved[k]) == 'object' && exists(saved[k], ip))
				st[k][ip] = saved[k][ip];
	}

	if (n)
		state_dirty = true;

	return n;
}

// --- locking ------------------------------------------------------------

// The lock is a directory: mkdir() is atomic, so of several processes (the
// daemon, `crowdblock sync` from cron) trying at once exactly one succeeds.
const LOCK_DIR = '/tmp/crowdblock.sync.lock.d';

// A lock older than this is assumed to belong to a process that died while
// holding it (killed, OOM, power loss) rather than one still syncing - sync()
// normally finishes in well under a minute - so it's stolen instead of
// blocking every future sync forever.
const STALE_LOCK_AGE = 600; // 10 minutes

// Returns the age of the lock in seconds, or null if it doesn't exist.
function lock_age() {
	let st = fs.stat(LOCK_DIR);
	return st ? time() - st.mtime : null;
}

// Acquire lock with timeout (in seconds)
// Returns true if lock acquired, false if timeout
function acquire_lock(timeout_sec) {
	let start = time();

	while (true) {
		if (fs.mkdir(LOCK_DIR))
			return true;

		let age = lock_age();
		if (age != null && age >= STALE_LOCK_AGE) {
			warn_log('sync lock stale (%ds old), assuming the previous holder died, taking it', age);

			// Rename first: only one of several processes finding the lock
			// stale succeeds, so none removes a lock that another has just
			// taken over.
			let old = LOCK_DIR + '.stale.' + getpid();
			if (fs.rename(LOCK_DIR, old))
				fs.rmdir(old);
			continue;
		}

		// Held by another (presumably still running) process.
		if (time() - start >= timeout_sec)
			return false;
		sleep(1);
	}
}

// Release lock by removing the lock directory
function release_lock() {
	fs.rmdir(LOCK_DIR);
}

// --- whitelist ----------------------------------------------------------

const ntp_servers = [ 'time.google.com', 'time.windows.com', 'pool.ntp.org' ];

// Resolved addresses are cached: a sync every few minutes must not run
// nslookup (and wait out its timeout when DNS is down) for every host each time.
const RESOLVE_TTL = 3600;        // successful lookup
const RESOLVE_RETRY = 600;       // failed lookup
let resolved = {};

// Addresses of `host` (an IP literal is returned as is), best effort: [] if
// it can't be resolved. Uses busybox nslookup, which every OpenWrt has.
function resolve(cfg, host) {
	if (iptoarr(host))
		return [ host ];

	// The name goes into a shell command line.
	if (!match(host, /^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$/))
		return [];

	let now = time();
	let c = resolved[host];
	if (c && c.until > now)
		return c.ips;

	let ips = [];
	let p = fs.popen(`nslookup ${host} 2>/dev/null`, 'r');
	if (p) {
		let in_answer = false;  // skip the "Server:/Address:" lines of the resolver
		for (let line = p.read('line'); line; line = p.read('line')) {
			if (match(line, /^Name:/)) {
				in_answer = true;
				continue;
			}
			let a = in_answer ? match(line, /^Address( [0-9]+)?:[ \t]*([^ \t]+)/) : null;
			if (a) {
				let ip = replace(a[2], /#[0-9]+$/, '');
				if (iptoarr(ip))
					push(ips, ip);
			}
		}
		p.close();
	}

	debug(cfg, 'whitelist: %s resolves to %s', host, length(ips) ? join(', ', ips) : 'nothing');
	resolved[host] = { ips, until: now + (length(ips) ? RESOLVE_TTL : RESOLVE_RETRY) };
	return ips;
}

// The router's own addresses, delegated prefixes and upstream DNS servers.
function local_addresses(cfg) {
	let res = [];

	let p = fs.popen('ubus call network.interface dump 2>/dev/null', 'r');
	if (!p)
		return res;

	let out = p.read('all');
	p.close();

	let dump;
	try { dump = json(out); } catch (e) { }

	if (type(dump) != 'object')
		return res;

	for (let iface in dump?.interface ?? []) {
		for (let a in iface['ipv4-address'] ?? [])
			push(res, a.address);
		for (let a in iface['ipv6-address'] ?? [])
			push(res, a.address);
		for (let a in iface['ipv6-prefix-assignment'] ?? [])
			push(res, `${a.address}/${a.mask}`);
		for (let a in iface['dns-server'] ?? [])
			push(res, a);
	}

	return res;
}

// The crowdblock server and common NTP servers must never end up blocked, or
// the router could no longer sync / keep its clock right.
function server_addresses(cfg) {
	let hosts = [ ...ntp_servers ];
	let m = match(trim(cfg?.server ?? ''), /^https?:\/\/(\[([0-9a-fA-F:]+)\]|[^\/?#:]+)/);
	if (m)
		push(hosts, m[2] ?? m[1]);

	let res = [];
	for (let host in hosts)
		for (let ip in resolve(cfg, host))
			push(res, ip);

	return res;
}

function build_whitelist(cfg) {
	let entries = [];

	for (let list in [ cfg.whitelist, local_addresses(cfg), server_addresses(cfg) ])
		for (let e in list)
			push(entries, e);

	return whitelist(entries, (e) => warn_log('ignoring invalid whitelist entry: %s', e));
}

// --- sync ---------------------------------------------------------------

function forget(st, ip) {
	delete st.entries[ip];
	delete st.reports[ip];
	delete st.countries[ip];
	delete st.sources[ip];
	delete st.static[ip];
}

let last_expire_check = 0;

// Returns the number of dropped entries.
// Only runs every EXPIRE_CHECK_INTERVAL seconds to reduce CPU load.
const EXPIRE_CHECK_INTERVAL = 300; // 5 minutes
function drop_expired(st, now) {
	if (now - last_expire_check < EXPIRE_CHECK_INTERVAL)
		return 0;
	last_expire_check = now;

	let n = 0;
	for (let ip in keys(st.entries))
		if (st.entries[ip] <= now) {
			forget(st, ip);
			n++;
		}
	return n;
}

// "1.2.3.4, 5.6.7.8 and 3 more" – addresses in debug lines, at most `max`.
function some(list, max) {
	let shown = join(', ', slice(list, 0, max));
	return (length(list) > max) ? sprintf('%s and %d more', shown, length(list) - max) : shown;
}

// Merges the downloaded list into the state, entry by entry (the list is
// never held in memory as a whole). Returns stats, with `error` if the list
// couldn't be read.
function merge(cfg, st, wl, now, dry_run) {
	let stats = { added: 0, refreshed: 0, invalid: 0, whitelisted: 0, below: 0, full: 0 };
	let seen = { added: [], whitelisted: [], below: [], full: [] };  // for debug
	let count = length(keys(st.entries));
	let expires = now + cfg.block_time;

	stats.error = each_entry(function(e) {
		if (type(e) != 'object' || type(e.ip) != 'string') {
			stats.invalid++;
			return;
		}

		// Don't rely on the server-side filter alone.
		if (!(type(e.reports) in [ 'int', 'double' ]) || e.reports < cfg.min_reports) {
			stats.below++;
			push(seen.below, e.ip);
			return;
		}

		let bytes = iptoarr(e.ip);
		if (!bytes) {
			stats.invalid++;
			return;
		}

		if (whitelisted(wl, bytes)) {
			stats.whitelisted++;
			push(seen.whitelisted, e.ip);
			return;
		}

		let ip = arrtoip(bytes);  // canonical form

		if (exists(st.entries, ip)) {
			st.entries[ip] = expires;
			st.reports[ip] = e.reports;
			if (e.country)
				st.countries[ip] = e.country;
			if (e.sources)
				st.sources[ip] = e.sources;
			stats.refreshed++;
		}
		else if (count < cfg.max_entries) {
			st.entries[ip] = expires;
			st.reports[ip] = e.reports;
			if (e.country)
				st.countries[ip] = e.country;
			if (e.sources)
				st.sources[ip] = e.sources;
			stats.added++;
			push(seen.added, ip);
			count++;
		}
		else {
			stats.full++;
			push(seen.full, ip);
		}
	});

	// Static blocklist: addresses from /etc/config/crowdblock that are
	// always blocked, independently of the server.
	let configured = {};
	for (let entry in cfg.static_block) {
		let v = trim('' + entry);
		if (v == '')
			continue;
		if (index(v, '/') >= 0)
			continue; // CIDR not yet supported in static blocklist
		let bytes = iptoarr(v);
		if (!bytes)
			continue;
		let ip = arrtoip(bytes);
		if (whitelisted(wl, bytes))
			continue;
		if (exists(st.entries, ip)) {
			st.entries[ip] = now + cfg.block_time;
			st.static[ip] = true;
			configured[ip] = true;
			stats.refreshed++;
		}
		else if (count < cfg.max_entries) {
			st.entries[ip] = now + cfg.block_time;
			st.static[ip] = true;
			configured[ip] = true;
			stats.added++;
			push(seen.added, ip);
			count++;
		}
		else {
			stats.full++;
			push(seen.full, ip);
		}
	}

	// Addresses removed from static_block: unblock them now rather than
	// leaving them to run out block_time. One that is also on the server list
	// (it has a report count) stays blocked, just no longer as a static one.
	stats.removed = 0;
	stats.new_ips = seen.added;
	for (let ip in keys(st.static)) {
		if (configured[ip])
			continue;
		if (exists(st.reports, ip)) {
			delete st.static[ip];
		}
		else {
			forget(st, ip);
			if (!dry_run)
				nft.unblock(ip);  // fails if it isn't blocked right now - nothing to undo
			stats.removed++;
		}
		state_dirty = true;
	}

	debug(cfg, 'merge: %d on the list: %d new, %d refreshed, %d whitelisted, %d below min_reports, %d invalid, %d over max_entries',
		stats.added + stats.refreshed + stats.whitelisted + stats.below + stats.invalid + stats.full,
		stats.added, stats.refreshed, stats.whitelisted, stats.below, stats.invalid, stats.full);
	for (let k in [ 'added', 'whitelisted', 'below', 'full' ])
		if (length(seen[k]))
			debug(cfg, 'merge: %s: %s', k, some(seen[k], 20));

	return stats;
}

// Entries may have been whitelisted after they were blocked.
function purge_whitelisted(st, wl) {
	let n = 0;

	for (let ip in keys(st.entries)) {
		let bytes = iptoarr(ip);
		let is_whitelisted = false;
		
		if (bytes) {
			// Single IP
			is_whitelisted = whitelisted(wl, bytes);
		} else {
			// CIDR - we check if the network address is whitelisted
			let cidr = parse_cidr(ip);
			if (cidr) {
				is_whitelisted = whitelisted(wl, cidr.bytes);
			}
		}

		if (is_whitelisted) {
			forget(st, ip);
			n++;
		}
	}

	return n;
}

// What a dry run would have done, on stdout.
function report_dry_run(cfg, st, stats, paused) {
	let now = time();
	let ips = stats.new_ips;
	let n = length(keys(st.entries));

	log('dry run: nothing was changed (no nftables update, state not saved)');
	log('would block %d addresses in total: %d new, %d refreshed, %d removed from static_block',
		n, stats.added, stats.refreshed, stats.removed);
	log('skipped: %d whitelisted, %d below min_reports (%d), %d invalid, %d over max_entries (%d)',
		stats.whitelisted, stats.below, cfg.min_reports, stats.invalid, stats.full, cfg.max_entries);

	let p = 0;
	for (let ip in keys(st.entries))
		if (ip in paused)
			p++;
	if (p)
		log('%d of them are paused and would stay unblocked', p);

	if (length(ips)) {
		log('new addresses:');
		for (let ip in ips) {
			let src = st.sources[ip] ? ' ' + join(',', st.sources[ip]) : '';
			log('  %s  reports=%s country=%s%s', ip, st.reports[ip] ?? 'static', st.countries[ip] ?? '-', src);
		}
	}
}

// Returns true on success. With `dry_run` it works on a copy of the state and
// only reports what would be blocked: nftables and the saved state stay as
// they are (except the list etag, which belongs to the downloaded list file).
function sync(cfg, real, dry_run) {
	let st = dry_run ? json(sprintf('%J', real)) : real;
	let persist = (s) => dry_run ? null : save_state(s);
	let now = time();
	let start = clock(true);
	let expired = drop_expired(st, now);
	if (expired > 0)
		state_dirty = true;
	debug(cfg, 'sync: %d entries in the state, %d expired since the last sync', length(keys(st.entries)), expired);

	// Acquire lock to prevent concurrent sync operations (timeout: 2x sync_interval)
	let lock_timeout = cfg.sync_interval * 2;
	if (!acquire_lock(lock_timeout)) {
		error_log('sync failed: could not acquire lock (another sync may be running)');
		return false;
	}

	// Ensure lock is released when we exit this function
	let lock_acquired = true;
	let release_lock_on_exit = function() {
		if (lock_acquired) {
			release_lock();
			lock_acquired = false;
		}
	};

	try {
		let res = fetch_blocklist(cfg, st.list_etag);
		let err = res.error;

		if (err) {
			// Nothing to do in nft: existing entries keep blocking until
			// their kernel timeout runs out.
			st.last_error = err;
			state_dirty = true;  // `status` and LuCI read this from the state file
			persist(st);
			error_log('sync failed: %s', err);
			release_lock_on_exit();
			return false;
		}

		let wl = build_whitelist(cfg);
		let purged = purge_whitelisted(st, wl);
		if (purged) {
			debug(cfg, 'sync: %d blocked entries now whitelisted, removed', purged);
			state_dirty = true;
		}
		let stats = merge(cfg, st, wl, now, dry_run);
		if (stats.added > 0 || stats.refreshed > 0 || stats.full > 0 || stats.removed > 0)
			state_dirty = true;

		if (stats.error) {
			st.last_error = stats.error;
			state_dirty = true;
			persist(st);
			error_log('sync failed: %s', stats.error);
			release_lock_on_exit();
			return false;
		}

		if (dry_run) {
			// The downloaded list file is now the new one; keep its etag
			// matching it (the next real sync merges from the file anyway).
			if (real.list_etag != res.etag) {
				real.list_etag = res.etag;
				state_dirty = true;
				save_state(real);
			}
			report_dry_run(cfg, st, stats, load_paused());
			release_lock_on_exit();
			return true;
		}

		// `/etc/init.d/firewall stop|restart` (fw4 flush) deletes all nftables
		// tables, ours included - recreate it instead of failing until restart.
		if (!nft.exists()) {
			warn_log('nftables table missing (firewall restarted?), recreating it');
			err = nft.setup(cfg);
			if (!err)
				state_dirty = true;
		}
		debug(cfg, 'sync: nftables exists check done, err=%s', err ?? 'none');

		if (!err) {
			let paused = load_paused();
			let nft_start = clock(true);
			err = nft.apply(st.entries, now, paused);

			if (cfg.debug) {
				let v4 = 0, v6 = 0, p = 0;
				for (let ip in st.entries)
					if (ip in paused)
						p++;
					else
						(index(ip, ':') >= 0) ? v6++ : v4++;
				debug(cfg, 'nftables: %d IPv4 + %d IPv6 addresses set, %d paused, %d ms%s',
					v4, v6, p, ms_since(nft_start), err ? ' – ' + err : '');
			}
		}

		st.list_etag = res.etag;
		st.last_sync = now;
		st.last_error = err;
		st.list_size = stats.added + stats.refreshed + stats.whitelisted + stats.below + stats.invalid + stats.full;
		state_dirty = true;
		persist(st);

		if (err) {
			error_log('nft update failed: %s', err);
			release_lock_on_exit();
			return false;
		}

		debug(cfg, 'sync: done in %d ms', ms_since(start));

		let how = res.not_modified ? ' (list not modified)'
			: res.delta ? sprintf(' (delta: %d changed, %d removed)', res.delta.upserted, res.delta.removed)
			: res.delta_failed ? sprintf(' (full list, delta rejected: %s)', res.delta_failed)
			: '';

		let line = sprintf('sync ok%s: %d blocked (+%d new, %d refreshed, %d whitelisted, %d purged, %d invalid%s)',
			how,
			length(keys(st.entries)), stats.added, stats.refreshed,
			stats.whitelisted, purged, stats.invalid,
			stats.full ? sprintf(', %d dropped: max_entries reached', stats.full) : '');

		// A sync that changed nothing runs every few minutes: debug only.
		if (stats.added || stats.removed || stats.full || purged)
			info('%s', line);
		else
			debug(cfg, '%s', line);

		release_lock_on_exit();
		return true;
	} catch (e) {
		// Handle any unexpected errors
		error_log('sync failed: unexpected error: %s at sync step', e.message);
		release_lock_on_exit();
		return false;
	}
}

// --- reporting ----------------------------------------------------------

const SOURCE_PATTERN = /^[a-z0-9_-]{1,32}$/;
const REPORT_INTERVAL = 300;      // log scan, seconds
const REPORT_AGAIN = 86400;       // the same address is reported once a day
const MAX_REPORTS_PER_SCAN = 20;  // don't flood the server after a long scan outage

// Returns null if `ip` may be reported, else the reason it may not: only
// public addresses, and never our own / whitelisted ones.
function report_refusal(cfg, ip, wl) {
	let bytes = iptoarr(ip);
	if (!bytes)
		return 'not an IP address';

	if (whitelisted(wl ?? build_whitelist(cfg), bytes))
		return 'private, reserved or whitelisted address';

	return null;
}

// "1.2.3.4" -> count of failed SSH logins in the system log (dropbear):
//   Bad password attempt for 'root' from 203.0.113.9:44322
//   Login attempt for nonexistent user from 203.0.113.9:44322
function failed_logins() {
	let counts = {};
	let p = fs.popen('logread -e dropbear 2>/dev/null', 'r');
	if (!p)
		return counts;

	for (let line = p.read('line'); length(line); line = p.read('line')) {
		let m = match(line, /(Bad password attempt for|Login attempt for nonexistent user).* from ([0-9a-fA-F:.]+):[0-9]+/);
		if (!m)
			continue;

		let bytes = iptoarr(m[2]);
		if (bytes) {
			let ip = arrtoip(bytes);
			counts[ip] = (counts[ip] ?? 0) + 1;
		}
	}
	p.close();

	return counts;
}

// One scan: reports every address with at least cfg.report_threshold failures
// that wasn't reported in the last REPORT_AGAIN seconds. `reported` is
// { ip: time } kept by the daemon.
function scan_log(cfg, reported) {
	let now = time();

	for (let ip in keys(reported))
		if (reported[ip] + REPORT_AGAIN <= now)
			delete reported[ip];

	let wl = null;  // built when the first candidate shows up
	let sent = 0;
	for (let ip, n in failed_logins()) {
		if (n < cfg.report_threshold || exists(reported, ip))
			continue;

		if (wl == null)
			wl = build_whitelist(cfg);
		let why = report_refusal(cfg, ip, wl);
		if (why) {
			debug(cfg, 'report: not reporting %s: %s', ip, why);
			reported[ip] = now;
			continue;
		}

		if (sent >= MAX_REPORTS_PER_SCAN) {
			debug(cfg, 'report: %d reports sent, the rest in the next scan', sent);
			break;
		}

		let res = report_ip(cfg, ip, 'auth');
		if (res.error) {
			warn_log('report %s failed: %s', ip, res.error);
			// A refused report would be refused again; a network error is retried.
			if (res.rejected)
				reported[ip] = now;
			else
				break;
			continue;
		}

		reported[ip] = now;
		sent++;
		info('reported %s (%d failed SSH logins)%s', ip, n, res.blacklisted ? ', now on the blocklist' : '');
	}
}

// --- commands -------------------------------------------------------------

function jitter(sec, pct) {
	return int(sec * 1000 * (1 + (rand() % (pct + 1)) / 100.0));
}

function cmd_run(cfg) {
	let st = load_state();
	let err = nft.setup(cfg);

	if (err)
		fatal(`cannot create nftables table: ${err}`);

	let restored = restore_state(cfg, st);
	if (restored) {
		info('restored %d blocked addresses from %s', restored, cfg.state_file);
		save_state(st);
		last_persist = time();  // the file is current
	}

	// After a restart, restore what we had before the first download.
	drop_expired(st, time());
	err = nft.apply(st.entries, time(), load_paused());
	if (err)
		error_log('cannot restore previous blocks: %s', err);

	info('crowdblock %s started: server=%s min_reports=%d block_time=%ds interval=%ds',
		VERSION, cfg.server, cfg.min_reports, cfg.block_time, cfg.sync_interval);

	srand(time());
	uloop.init();

	let failures = 0;
	let timer;

	timer = uloop.timer(1000 + rand() % 30000, function() {
		if (sync(cfg, st)) {
			failures = 0;
			persist_state(cfg, st);
			timer.set(jitter(cfg.sync_interval, 10));
		}
		else {
			// Exponential backoff: 60s, 120s, 240s ... capped at sync_interval.
			// Thousands of routers must not hammer a server that is down.
			let delay = 60 * (1 << (failures < 6 ? failures : 6));
			failures++;
			timer.set(jitter(delay < cfg.sync_interval ? delay : cfg.sync_interval, 25));
		}

		// For `status` and LuCI (other processes).
		st.failures = failures;
		state_dirty = true;
		save_state(st);
	});

	if (cfg.report_attacks) {
		let reported = {};
		let scan_timer;

		info('reporting attackers: %d failed SSH logins, scan every %ds', cfg.report_threshold, REPORT_INTERVAL);
		scan_timer = uloop.timer(60000 + rand() % 30000, function() {
			try {
				scan_log(cfg, reported);
			} catch (e) {
				error_log('log scan failed: %s', e.message);
			}
			scan_timer.set(REPORT_INTERVAL * 1000);
		});
	}

	uloop.run();
}

function cmd_sync(cfg, dry_run) {
	let st = load_state();

	// Recreating an existing table would drop the current blocks (also those
	// of a running daemon) for as long as the download keeps failing.
	if (!dry_run && !nft.exists()) {
		let err = nft.setup(cfg);
		if (err)
			fatal(`cannot create nftables table: ${err}`);

		drop_expired(st, time());
		nft.apply(st.entries, time(), load_paused());
	}

	exit(sync(cfg, st, dry_run) ? 0 : 1);
}

function cmd_report(cfg, arg, source) {
	if (source == null)
		source = 'manual';

	if (!match(source, SOURCE_PATTERN))
		fatal('invalid source (up to 32 characters a-z, 0-9, _ and -)');

	let bytes = iptoarr(arg ?? '');
	if (!bytes)
		fatal(`invalid IP address: ${arg}`);

	let ip = arrtoip(bytes);
	let why = report_refusal(cfg, ip);
	if (why)
		fatal(`not reporting ${ip}: ${why}`);

	let res = report_ip(cfg, ip, source);
	if (res.error)
		fatal(`report failed: ${res.error}`);

	log('reported %s (source %s)%s', ip, source, res.blacklisted ? ', now on the blocklist' : '');
}

// The paused list is the source of truth; the nft change applies it right
// away instead of waiting for the next sync.
function cmd_pause(arg, pause) {
	let bytes = iptoarr(arg ?? '');
	if (!bytes)
		fatal(`invalid IP address: ${arg}`);

	let ip = arrtoip(bytes);  // canonical form, as in the state
	let paused = filter(load_paused(), (p) => p != ip);

	if (pause)
		push(paused, ip);

	if (!save_paused(paused))
		fatal('cannot save the list of paused addresses');

	if (!nft.exists())
		return;

	if (pause) {
		// Fails when the address is not blocked right now - nothing to undo.
		nft.unblock(ip);
	}
	else {
		let ttl = (load_state().entries[ip] ?? 0) - time();
		let err = (ttl > 0) ? nft.block(ip, ttl) : null;

		if (err)
			fatal(err);
	}
}

// Open file descriptors of a running process (null if it isn't running).
// A count that only grows means a leak, e.g. of ubus connections in ubusd.
function fd_count(name) {
	let p = fs.popen('pidof ' + name + ' 2>/dev/null', 'r');
	let pid = p ? trim(p.read('all') ?? '') : '';
	if (p)
		p.close();

	let fds = match(pid, /^[0-9]+$/) ? fs.lsdir('/proc/' + pid + '/fd') : null;
	return fds ? length(fds) : null;
}

function cmd_status() {
	let st = load_state();
	let now = time();
	let paused = load_paused();
	let v4 = 0, v6 = 0, p = 0;

	for (let ip, expires in st.entries)
		if (expires <= now)
			continue;
		else if (ip in paused)
			p++;
		else
			(index(ip, ':') >= 0) ? v6++ : v4++;

	info('blocked:    %d IPv4, %d IPv6 (%d paused)', v4, v6, p);
	info('last sync:  %s', st.last_sync ? sprintf('%ds ago', now - st.last_sync) : 'never');
	info('last error: %s', st.last_error ?? '-');
	info('failures:   %d in a row', st.failures ?? 0);
	info('list size:  %s', st.list_size != null ? '' + st.list_size : '-');
	info('ubusd fds:  %s', fd_count('ubusd') ?? '-');

	for (let line in nft.counters())
		info('%s', line);
}

function usage() {
	warn('Usage: crowdblock run|sync [--dry-run]|status|teardown|report IP [SOURCE]|pause IP|resume IP\n');
	exit(1);
}

fs.mkdir(STATE_DIR, 0o700);

let command = ARGV[0];

if (command == 'status') {
	cmd_status();
}
else if (command == 'teardown') {
	let err = nft.teardown();
	if (err)
		fatal(err);
}
else if (command == 'pause' || command == 'resume') {
	cmd_pause(ARGV[1], command == 'pause');
}
else if (command == 'run' || command == 'sync' || command == 'report') {
	let res = load_config();
	if (res.error)
		fatal(`config error: ${res.error}`);

	if (command == 'run')
		cmd_run(res.cfg);
	else if (command == 'report')
		cmd_report(res.cfg, ARGV[1], ARGV[2]);
	else if (ARGV[1] == '--dry-run' || ARGV[1] == null)
		cmd_sync(res.cfg, ARGV[1] == '--dry-run');
	else
		usage();
}
else {
	usage();
}