config crowdblock 'main'
	# Disabled until the server address is configured
	option enabled '0'

	# Base URL of the collector server (no trailing slash needed)
	option server 'https://crowdblock.example.org'

	# API key from POST /api/v1/api-keys (sent as the HTTP Basic auth password)
	option api_key ''

	# Language of the LuCI pages: en, pl, de; empty = the language of LuCI
	option language ''

	# How many distinct users must report an IP before we trust it:
	# 1, 5, 10, 20 or 50 (the thresholds the server serves)
	option min_reports '5'

	# Only count reports from this recent period: 1h, 6h, 24h or 7d
	option report_window '6h'

	# How long an IP stays blocked after it was last seen on the list.
	# Accepts plain seconds or a suffix: s, m, h, d (e.g. 30m, 1h, 24h, 7d)
	option block_time '24h'

	# How often to download the list (randomised by up to 10%)
	option sync_interval '10m'

	# Upper bound of blocked addresses (protects RAM on small devices)
	option max_entries '20000'

	# Also drop forwarded traffic (protects port-forwarded LAN services)
	option block_forward '1'

	# Verify the server TLS certificate (requires ca-bundle / ca-certificates)
	option verify_tls '1'

	# HTTP timeout in seconds
	option timeout '30'

	# Details of every sync in the system log (logread -e crowdblock)
	option debug '0'

	# Addresses / networks that must never be blocked. Private, reserved
	# and the router's own addresses + DNS servers are whitelisted automatically.
	#list whitelist '198.51.100.7'
	#list whitelist '2001:db8:1234::/48'
