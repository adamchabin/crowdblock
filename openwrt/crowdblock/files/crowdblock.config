config crowdblock 'main'
	# Disabled until the server address is configured
	option enabled '0'

	# Base URL of the collector server (no trailing slash needed)
	option server 'https://crowdblock.example.org'

	# API key from POST /api/v1/api-keys (sent as the HTTP Basic auth password)
	option api_key ''

	# How many distinct users must report an IP before we block it:
	# 1, 5, 10, 20 or 50 (the thresholds the server serves)
	option min_reports '5'

	# Only count reports from this recent period: 1h, 6h, 24h or 7d
	option report_window '6h'

	# How long a blocked address stays blocked without a refresh (kernel
	# timeout). Accepts plain seconds or a suffix: s, m, h, d (e.g. 30m, 1h, 24h)
	option block_time '24h'

	# How often to download the list (the full list every time)
	option sync_interval '10m'

	# Upper bound of blocked addresses (protects RAM on small devices)
	option max_entries '20000'

	# Maximum response body size from the server, in MiB.
	# Increase if you use a large limit and your router has enough RAM.
	option max_body '8'

	# Keep /tmp/crowdblock/batch.nft after uploading it to nftables (debugging).
	option keep_batch_nft '0'

	# Maximum number of addresses to request from the server per sync.
	# 0 = unlimited (server decides). Other allowed values: 5000, 10000,
	# 50000, 100000, 250000, 500000.
	option limit '0'

	# Verify the server TLS certificate (requires ca-bundle / ca-certificates)
	option verify_tls '1'

	# HTTP timeout in seconds
	option timeout '30'

	# Details of every sync in the system log (logread -e crowdblock)
	option debug '0'
