#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/crowdblock

start_service() {
	local enabled

	config_load crowdblock
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Called by rc.common after the daemon has been killed:
# removing the table unblocks everything.
service_stopped() {
	"$PROG" teardown
}

# procd would not restart an instance whose command line did not change,
# so a config change needs an explicit restart.
reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger crowdblock
}
